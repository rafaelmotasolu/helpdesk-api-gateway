# ==============================================================================
# HELPDESK API GATEWAY - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Server Configuration
GATEWAY_PORT=8080
PORT=8080

# Security (JWT) - Chave secreta de no mínimo 256 bits (HMAC-SHA)
JWT_SECRET=your_jwt_secret_key_here_min_256_bits_base64_or_hex

# Microservices URLs for Gateway Routing
USER_SERVICE_URL=http://localhost:8081
TICKET_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083

